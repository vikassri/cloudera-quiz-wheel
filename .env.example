SUPABASE_URL=https://your-project.supabase.co

# Server-side secret key — NOT the publishable key.
# Dashboard → Settings → API Keys → Secret keys → sb_secret_...
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Legacy alternative (JWT, starts with eyJ...):
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

PORT=3000
